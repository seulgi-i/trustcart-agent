generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String @id
  name        String
  category    String
  priceCents  Int
  stock       Int
  seller      String
  description String
  isMalicious Boolean @default(false)
}

model Approval {
  id        String   @id @default(cuid())
  cartJson  String
  totalCents Int
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  outcome   String
  detail    String
  createdAt DateTime @default(now())
}
