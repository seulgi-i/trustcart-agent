generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model DemoSession {
  id        String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime
  // The agent's current proposal (JSON CartLine[]). Checkout evaluates this server copy, never model-supplied arguments.
  cartJson  String   @default("[]")
  intents   Intent[]
  orders    Order[]
  policy    SessionPolicy?
}

// Layer-2 spending policy, set only through the /policy page. No row = defaults (see src/domain/spending-policy.ts).
// Bounds are validated on write against the Layer-1 limits (src/domain/layer1.ts). The plain columns are the
// EFFECTIVE policy. A loosening waits in pendingJson (the full requested policy) until pendingEffectiveAt (now + 24 h),
// when the next read promotes it.
model SessionPolicy {
  sessionId                 String      @id
  session                   DemoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  perOrderMaxCents          Int
  dailyMaxCents             Int
  allowedCategories         String[]
  // JSON Record<category, cents>
  perCategoryMaxJson        String      @default("{}")
  requireApprovalAboveCents Int
  // Local hours in `timezone`, end exclusive; start > end is overnight.
  allowedStartHour          Int         @default(0)
  allowedEndHour            Int         @default(24)
  allowedWeekdays           Int[]       @default([0, 1, 2, 3, 4, 5, 6])
  timezone                  String      @default("America/New_York")
  prechargeDelaySeconds     Int         @default(60)
  pendingJson               String?
  pendingEffectiveAt        DateTime?
  updatedAt                 DateTime    @updatedAt
}

// Purchase intent set by the user through the UI, never by the model. A change is a new row; the latest one applies.
model Intent {
  id          String      @id @default(cuid())
  sessionId   String
  session     DemoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  budgetCents Int
  category    String
  quantity    Int
  createdAt   DateTime    @default(now())
  orders      Order[]

  @@index([sessionId])
}

// Runtime catalog only. Evaluation labels live in src/eval and are deliberately not stored.
model Product {
  id          String @id
  name        String
  category    String
  priceCents  Int
  stock       Int
  seller      String
  description String
}

// status: READY | NEEDS_APPROVAL -> PAYMENT_CREATING -> AWAITING_PAYMENT -> CAPTURING -> PAID | FAILED,
// or -> REJECTED (inbox) / CANCELLED (buyer cancel at PayPal). DENIED is terminal.
model Order {
  id              String      @id @default(cuid())
  sessionId       String
  session         DemoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  intentId        String
  intent          Intent      @relation(fields: [intentId], references: [id])
  status          String
  cartJson        String
  totalCents      Int
  evaluationJson  String
  provider        String?
  providerOrderId String?     @unique
  approvalUrl     String?
  captureId       String?     @unique
  failureReason   String?
  // Pre-charge notice: capture is refused until the session's effective prechargeDelaySeconds after captureScheduledAt, and for good
  // once captureCanceled is set. Enforced from these columns, never from an in-memory timer.
  captureScheduledAt DateTime?
  captureCanceled    Boolean   @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([sessionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  sessionId String?
  action    String
  outcome   String
  detail    String
  createdAt DateTime @default(now())

  @@index([sessionId])
}

// Fixed-window counter for /api/chat. One row per (key, window start); the count is incremented atomically.
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}
