generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model DemoSession {
  id        String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime
  // The agent's current proposal (JSON CartLine[]). Checkout evaluates this server copy, never model-supplied arguments.
  cartJson  String   @default("[]")
  intents   Intent[]
  orders    Order[]
}

// Purchase intent set by the user through the UI, never by the model. A change is a new row; the latest one applies.
model Intent {
  id          String      @id @default(cuid())
  sessionId   String
  session     DemoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  budgetCents Int
  category    String
  quantity    Int
  createdAt   DateTime    @default(now())
  orders      Order[]

  @@index([sessionId])
}

// Runtime catalog only. Evaluation labels live in src/eval and are deliberately not stored.
model Product {
  id          String @id
  name        String
  category    String
  priceCents  Int
  stock       Int
  seller      String
  description String
}

// status: READY | NEEDS_APPROVAL -> PAYMENT_CREATING -> AWAITING_PAYMENT -> CAPTURING -> PAID | FAILED,
// or -> REJECTED (inbox) / CANCELLED (buyer cancel at PayPal). DENIED is terminal.
model Order {
  id              String      @id @default(cuid())
  sessionId       String
  session         DemoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  intentId        String
  intent          Intent      @relation(fields: [intentId], references: [id])
  status          String
  cartJson        String
  totalCents      Int
  evaluationJson  String
  provider        String?
  providerOrderId String?     @unique
  approvalUrl     String?
  captureId       String?     @unique
  failureReason   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([sessionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  sessionId String?
  action    String
  outcome   String
  detail    String
  createdAt DateTime @default(now())

  @@index([sessionId])
}
