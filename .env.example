# Copy to .env and fill in locally. Never commit .env or paste secret values into chats or issues.
DATABASE_URL="file:./dev.db"

# AI provider: set one. If both are set, OpenAI is used.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-4-5

# PayPal Sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox).
# The code only talks to https://api-m.sandbox.paypal.com and refuses any live setting.
# Leave PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET empty to use the labeled mock provider. Once both are set, the
# merchant ID below is required too, or payment routes fail closed (no fallback to the mock).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Merchant ID of the sandbox business (seller) account that receives the payment.
PAYPAL_SANDBOX_MERCHANT_ID=

# Free tier option (Google AI Studio)
GOOGLE_GENERATIVE_AI_API_KEY=
# default gemini-3.5-flash (tool calling OK on free tier; 2.5-flash is 404 for new users, 3.8-flash often 503)
GOOGLE_MODEL=
