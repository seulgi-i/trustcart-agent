# Copy to .env and fill in locally. Never commit .env or paste secret values into chats or issues.

# Postgres (e.g. Supabase or Neon). DATABASE_URL is the runtime (pooled) URL; DIRECT_URL is the direct connection
# used by `prisma migrate`. For a plain local Postgres, set both to the same URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DB?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB"
# Optional: throwaway Postgres for `npm test` DB integration tests. Unset = those tests are skipped.
TEST_DATABASE_URL=

# Public origin used for PayPal return/cancel URLs. Falls back to https://$VERCEL_URL, then http://localhost:3000 (dev only).
APP_BASE_URL=

# Demo password gate. Unset = gate disabled (local dev). SESSION_SECRET is optional; if unset the cookie signing key
# is derived from DEMO_PASSWORD.
DEMO_PASSWORD=
SESSION_SECRET=

# /api/chat rate limits (defaults: 10 per session per hour, 30 per IP per day).
RATE_LIMIT_SESSION_PER_HOUR=
RATE_LIMIT_GLOBAL_PER_DAY=

# Layer-1 system limits (fixed for users: /policy shows them read-only and cannot raise them). Empty = default.
# Positive integers; windows are capped at 1440 minutes. Payments counted = orders in PAYMENT_CREATING,
# AWAITING_PAYMENT, CAPTURING or PAID, by their last payment step.
# Velocity: at most N payments per session within M minutes (default 3 per 30).
LAYER1_VELOCITY_MAX=
LAYER1_VELOCITY_WINDOW_MINUTES=
# Split payment: payments for the same product or seller within the window may not add up to more than this
# (default 50000 = the $500 per-payment hard cap, which is also its maximum; default window 60 minutes).
LAYER1_SPLIT_SINGLE_LIMIT_CENTS=
LAYER1_SPLIT_WINDOW_MINUTES=
# Duplicate payment: same cart and total again within this many minutes (default 10).
LAYER1_DUPLICATE_WINDOW_MINUTES=
# Hard caps per UTC day / UTC month (defaults 500000 = $5,000 and 2000000 = $20,000). The user's daily maximum
# must fit under the daily cap; the monthly cap is never lower than the daily cap.
LAYER1_DAILY_HARD_CAP_CENTS=
LAYER1_MONTHLY_HARD_CAP_CENTS=
# The pre-charge countdown is a Layer-2 user setting on /policy (30-600 s, default 60); PRECHARGE_DELAY_SECONDS is no
# longer read.

# AI provider: set one. Precedence: OpenAI, then Anthropic, then Google.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-4-5

# Free tier option (Google AI Studio)
GOOGLE_GENERATIVE_AI_API_KEY=
# Empty = gemini-3.5-flash (tool calling works on the free tier). Use a cheaper/faster model while developing and
# keep the default for the public demo so the free-tier quota is spent on judged runs.
GOOGLE_MODEL=

# PayPal Sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox).
# The code only talks to https://api-m.sandbox.paypal.com and refuses any live setting.
# Leave PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET empty to use the labeled mock provider. Once both are set, the
# merchant ID below is required too, or payment routes fail closed (no fallback to the mock).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Merchant ID of the sandbox business (seller) account that receives the payment.
PAYPAL_SANDBOX_MERCHANT_ID=
