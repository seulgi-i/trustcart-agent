  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
